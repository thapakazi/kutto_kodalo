#!/usr/bin/env bash
# bootstrap — take a fresh macOS or Linux box to a working shell in one command.
#
#   1. detect the OS and package manager (offer to install Homebrew on macOS)
#   2. install everything the modules declare via @requires
#   3. back up any existing ~/.shellrc, then symlink ~/.shellrc -> repo/shellrc
#   4. add the source line to ~/.zshrc and ~/.bashrc, idempotently
#   5. create modules/local/ for machine-specific config
#   6. run bin/doctor
#
# Nothing is overwritten without a timestamped backup, and every sudo says why.
#
# Usage:
#   bin/bootstrap                 do it
#   bin/bootstrap --dry-run       print what it would do, change nothing
#   bin/bootstrap --no-install    skip package installation, just wire things up
#   bin/bootstrap --yes           assume yes for every prompt
#   bin/bootstrap --package-for <tool>...
#                                 print `tool<TAB>package` for this platform
#                                 (read-only; bin/doctor uses this)

set -euo pipefail

# ------------------------------------------------------------------ locate --

_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
    _link=$(command ls -ld -- "$_self" | sed -e 's/.* -> //')
    case "$_link" in
        /*) _self="$_link" ;;
        *)  _self="$(dirname -- "$_self")/$_link" ;;
    esac
done
REPO="$(cd -- "$(dirname -- "$_self")/.." && pwd -P)"
unset _self _link

set +u
# shellcheck source=/dev/null
. "$REPO/lib/10-colors.sh" 2>/dev/null || {
    C_RESET='' C_BOLD='' C_DIM='' C_RED='' C_GREEN='' C_YELLOW='' C_CYAN=''
    C_B_RED='' C_B_GREEN='' C_B_YELLOW='' C_B_CYAN=''
}
set -u

# ------------------------------------------------------- platform detection --

case "$(uname -s)" in
    Darwin) OS=darwin ;;
    Linux)  OS=linux ;;
    *)      OS=unknown ;;
esac

has() { command -v "$1" >/dev/null 2>&1; }

detect_pkgmgr() {
    if [ "$OS" = darwin ]; then
        has brew && { printf 'brew'; return 0; }
        printf ''
        return 0
    fi
    if   has apt-get; then printf 'apt'
    elif has pacman;  then printf 'pacman'
    elif has dnf;     then printf 'dnf'
    else printf ''
    fi
}
PKGMGR="$(detect_pkgmgr)"

# ==========================================================================
# tool -> package mapping
#
# This is the ONE place the repo knows that `magick` lives in imagemagick and
# `kubectl` in kubernetes-cli. bin/doctor asks this script rather than keeping
# a second copy.
#
# Returns:
#   <name>   the package to install
#   system   already part of the base OS, nothing to install
#   (empty)  no package on this platform — the user installs it by hand
# ==========================================================================

pkg_for() {
    local tool="$1"

    # macOS-only built-ins
    case "$tool" in
        pbcopy | pbpaste | open)
            if [ "$OS" = darwin ]; then printf 'system'; return 0; fi
            ;;
    esac

    # things every POSIX box already has
    case "$tool" in
        base64 | column | curl | du | mount | umount | tar | sed | awk | grep | \
        find | date | ssh | ssh-keygen | zip | unzip | lsof | sudo | tcpdump)
            printf 'system'
            return 0
            ;;
    esac

    case "$PKGMGR" in
        brew)
            case "$tool" in
                adb)            printf 'android-platform-tools' ;;
                certbot)        printf 'certbot' ;;
                cowsay)         printf 'cowsay' ;;
                fortune)        printf 'fortune' ;;
                fzf)            printf 'fzf' ;;
                gcalcli)        printf 'gcalcli' ;;
                mplayer)        printf 'mplayer' ;;
                nmap)           printf 'nmap' ;;
                qrencode)       printf 'qrencode' ;;
                watch)          printf 'watch' ;;
                wget)           printf 'wget' ;;
                yt-dlp)         printf 'yt-dlp' ;;
                youtube-dl)     printf 'youtube-dl' ;;
                ansible)        printf 'ansible' ;;
                aws)            printf 'awscli' ;;
                chruby)         printf 'chruby' ;;
                docker)         printf 'docker' ;;
                ffmpeg)         printf 'ffmpeg' ;;
                gcloud)         printf 'google-cloud-sdk' ;;
                git)            printf 'git' ;;
                go)             printf 'go' ;;
                gpg)            printf 'gnupg' ;;
                gsed)           printf 'gnu-sed' ;;
                hf)             printf 'huggingface-cli' ;;
                jq)             printf 'jq' ;;
                k9s)            printf 'k9s' ;;
                kind)           printf 'kind' ;;
                kubectl)        printf 'kubernetes-cli' ;;
                limactl)        printf 'lima' ;;
                magick)         printf 'imagemagick' ;;
                nvm)            printf 'nvm' ;;
                openssl)        printf 'openssl' ;;
                pip | pip3 | python3) printf 'python' ;;
                potrace)        printf 'potrace' ;;
                psql)           printf 'libpq' ;;
                redis-cli)      printf 'redis' ;;
                scrcpy)         printf 'scrcpy' ;;
                shellcheck)     printf 'shellcheck' ;;
                just)           printf 'just' ;;
                *)              printf '' ;;
            esac
            ;;
        apt)
            case "$tool" in
                adb)            printf 'android-tools-adb' ;;
                certbot)        printf 'certbot' ;;
                cowsay)         printf 'cowsay' ;;
                fzf)            printf 'fzf' ;;
                mplayer)        printf 'mplayer' ;;
                nmap)           printf 'nmap' ;;
                qrencode)       printf 'qrencode' ;;
                wget)           printf 'wget' ;;
                xcowsay)        printf 'xcowsay' ;;
                yt-dlp)         printf 'yt-dlp' ;;
                youtube-dl)     printf 'youtube-dl' ;;
                fortune)        printf 'fortune-mod' ;;
                watch)          printf 'procps' ;;
                ansible)        printf 'ansible' ;;
                aws)            printf 'awscli' ;;
                docker)         printf 'docker.io' ;;
                ffmpeg)         printf 'ffmpeg' ;;
                git)            printf 'git' ;;
                go)             printf 'golang' ;;
                gpg)            printf 'gnupg' ;;
                gsed)           printf 'system' ;;   # GNU sed is the system sed
                jq)             printf 'jq' ;;
                magick)         printf 'imagemagick' ;;
                openssl)        printf 'openssl' ;;
                pip | pip3)     printf 'python3-pip' ;;
                potrace)        printf 'potrace' ;;
                psql)           printf 'postgresql-client' ;;
                python3)        printf 'python3' ;;
                redis-cli)      printf 'redis-tools' ;;
                scrcpy)         printf 'scrcpy' ;;
                shellcheck)     printf 'shellcheck' ;;
                wl-copy | wl-paste) printf 'wl-clipboard' ;;
                x2x)            printf 'x2x' ;;
                xdg-open)       printf 'xdg-utils' ;;
                xclip)          printf 'xclip' ;;
                xsel)           printf 'xsel' ;;
                *)              printf '' ;;
            esac
            ;;
        pacman)
            case "$tool" in
                adb)            printf 'android-tools' ;;
                certbot)        printf 'certbot' ;;
                cowsay)         printf 'cowsay' ;;
                fzf)            printf 'fzf' ;;
                mplayer)        printf 'mplayer' ;;
                nmap)           printf 'nmap' ;;
                qrencode)       printf 'qrencode' ;;
                wget)           printf 'wget' ;;
                xcowsay)        printf 'xcowsay' ;;
                yt-dlp)         printf 'yt-dlp' ;;
                youtube-dl)     printf 'youtube-dl' ;;
                fortune)        printf 'fortune-mod' ;;
                watch)          printf 'procps-ng' ;;
                ansible)        printf 'ansible' ;;
                aws)            printf 'aws-cli' ;;
                docker)         printf 'docker' ;;
                ffmpeg)         printf 'ffmpeg' ;;
                git)            printf 'git' ;;
                go)             printf 'go' ;;
                gpg)            printf 'gnupg' ;;
                gsed)           printf 'system' ;;
                jq)             printf 'jq' ;;
                k9s)            printf 'k9s' ;;
                kind)           printf 'kind' ;;
                kubectl)        printf 'kubectl' ;;
                magick)         printf 'imagemagick' ;;
                openssl)        printf 'openssl' ;;
                pip | pip3)     printf 'python-pip' ;;
                potrace)        printf 'potrace' ;;
                psql)           printf 'postgresql-libs' ;;
                python3)        printf 'python' ;;
                redis-cli)      printf 'redis' ;;
                scrcpy)         printf 'scrcpy' ;;
                shellcheck)     printf 'shellcheck' ;;
                wl-copy | wl-paste) printf 'wl-clipboard' ;;
                x2x)            printf 'x2x' ;;
                xdg-open)       printf 'xdg-utils' ;;
                xclip)          printf 'xclip' ;;
                xsel)           printf 'xsel' ;;
                *)              printf '' ;;
            esac
            ;;
        dnf)
            case "$tool" in
                adb)            printf 'android-tools' ;;
                certbot)        printf 'certbot' ;;
                cowsay)         printf 'cowsay' ;;
                fzf)            printf 'fzf' ;;
                mplayer)        printf 'mplayer' ;;
                nmap)           printf 'nmap' ;;
                qrencode)       printf 'qrencode' ;;
                wget)           printf 'wget' ;;
                xcowsay)        printf 'xcowsay' ;;
                yt-dlp)         printf 'yt-dlp' ;;
                youtube-dl)     printf 'youtube-dl' ;;
                fortune)        printf 'fortune-mod' ;;
                watch)          printf 'procps-ng' ;;
                ansible)        printf 'ansible' ;;
                aws)            printf 'awscli' ;;
                docker)         printf 'moby-engine' ;;
                ffmpeg)         printf 'ffmpeg' ;;
                git)            printf 'git' ;;
                go)             printf 'golang' ;;
                gpg)            printf 'gnupg2' ;;
                gsed)           printf 'system' ;;
                jq)             printf 'jq' ;;
                magick)         printf 'ImageMagick' ;;
                openssl)        printf 'openssl' ;;
                pip | pip3)     printf 'python3-pip' ;;
                potrace)        printf 'potrace' ;;
                psql)           printf 'postgresql' ;;
                python3)        printf 'python3' ;;
                redis-cli)      printf 'redis' ;;
                scrcpy)         printf 'scrcpy' ;;
                shellcheck)     printf 'ShellCheck' ;;
                wl-copy | wl-paste) printf 'wl-clipboard' ;;
                x2x)            printf 'x2x' ;;
                xdg-open)       printf 'xdg-utils' ;;
                xclip)          printf 'xclip' ;;
                xsel)           printf 'xsel' ;;
                *)              printf '' ;;
            esac
            ;;
        *)
            printf ''
            ;;
    esac
}

# --package-for: read-only query interface, used by bin/doctor
if [ "${1:-}" = "--package-for" ]; then
    shift
    for t in "$@"; do
        p="$(pkg_for "$t")"
        [ "$p" = system ] && p=""
        printf '%s\t%s\n' "$t" "$p"
    done
    exit 0
fi

# ------------------------------------------------------------------- flags --

DRY_RUN=0
NO_INSTALL=0
ASSUME_YES=0

while [ $# -gt 0 ]; do
    case "$1" in
        -n | --dry-run)  DRY_RUN=1 ;;
        --no-install)    NO_INSTALL=1 ;;
        -y | --yes)      ASSUME_YES=1 ;;
        -h | --help)
            sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            printf 'bootstrap: unknown option: %s\n' "$1" >&2
            exit 2
            ;;
    esac
    shift
done

# ------------------------------------------------------------------- output --

step()  { printf '\n%s==>%s %s%s%s\n' "$C_B_CYAN" "$C_RESET" "$C_BOLD" "$*" "$C_RESET"; }
ok()    { printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
note()  { printf '  %s·%s %s\n' "$C_DIM" "$C_RESET" "$*"; }
warn()  { printf '  %s⚠%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
die()   { printf '\n%serror:%s %s\n' "$C_B_RED" "$C_RESET" "$*" >&2; exit 1; }

# Everything that changes the machine goes through run(), so --dry-run is
# guaranteed to be inert.
run() {
    if [ "$DRY_RUN" -eq 1 ]; then
        printf '  %swould:%s %s\n' "$C_YELLOW" "$C_RESET" "$*"
        return 0
    fi
    printf '  %s$%s %s\n' "$C_DIM" "$C_RESET" "$*"
    "$@"
}

ask() {
    local prompt="$1" reply=""
    [ "$ASSUME_YES" -eq 1 ] && return 0
    [ "$DRY_RUN" -eq 1 ] && { printf '  %swould ask:%s %s\n' "$C_YELLOW" "$C_RESET" "$prompt"; return 1; }
    [ -t 0 ] || return 1
    printf '  %s%s%s [y/N]: ' "$C_CYAN" "$prompt" "$C_RESET"
    read -r reply || return 1
    case "$reply" in
        [yY] | [yY][eE][sS]) return 0 ;;
        *) return 1 ;;
    esac
}

STAMP="$(date +%Y%m%d-%H%M%S)"

printf '%s%sshellrc bootstrap%s  %s%s%s\n' \
    "$C_BOLD" "$C_B_CYAN" "$C_RESET" "$C_DIM" "$REPO" "$C_RESET"
if [ "$DRY_RUN" -eq 1 ]; then
    printf '%sdry run — nothing will be changed%s\n' "$C_YELLOW" "$C_RESET"
fi

if [ "$OS" = unknown ]; then
    die "unsupported OS: $(uname -s). Only macOS and Linux are supported."
fi

# ================================================================ 1. homebrew --

step "Package manager"

if [ -z "$PKGMGR" ] && [ "$OS" = darwin ]; then
    warn "Homebrew is not installed — it is how everything else gets installed on macOS."
    if ask "Install Homebrew now?"; then
        # Conventions forbid `curl | bash`: fetch the installer, show it, then
        # run it deliberately.
        installer="$(mktemp "${TMPDIR:-/tmp}/brew-install.XXXXXXXX")"
        run curl -fsSL -o "$installer" \
            https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
        if [ "$DRY_RUN" -eq 0 ]; then
            note "downloaded $(wc -c < "$installer" | tr -d ' ') bytes to $installer"
            note "review it with: less $installer"
            if ask "Run the Homebrew installer? (it will ask for your password — Homebrew needs sudo to create /opt/homebrew)"; then
                /bin/bash "$installer"
            else
                rm -f "$installer"
                die "Homebrew declined. Install it yourself, then re-run bin/bootstrap."
            fi
            rm -f "$installer"
        fi
        # brew is not on PATH until the shellenv runs
        for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
            if [ -x "$candidate" ]; then
                eval "$("$candidate" shellenv)"
                break
            fi
        done
        PKGMGR="$(detect_pkgmgr)"
    else
        warn "continuing without Homebrew — package installation will be skipped"
        NO_INSTALL=1
    fi
fi

if [ -n "$PKGMGR" ]; then
    ok "using $PKGMGR"
else
    warn "no package manager detected; skipping package installation"
    NO_INSTALL=1
fi

# =============================================================== 2. packages --

step "Dependencies"

if [ ! -x "$REPO/bin/shellrc-doc" ]; then
    die "bin/shellrc-doc is missing — cannot derive the dependency list"
fi

# The dependency set is DERIVED from the @requires tags in the modules, so it
# stays correct as modules come and go. Never hardcode it here.
REQUIRES="$("$REPO/bin/shellrc-doc" --list-requires)"

TO_INSTALL=""
MANUAL=""

add_pkg() {
    case " $TO_INSTALL " in
        *" $1 "*) : ;;
        *) TO_INSTALL="$TO_INSTALL $1" ;;
    esac
}
add_manual() {
    case " $MANUAL " in
        *" $1 "*) : ;;
        *) MANUAL="$MANUAL $1" ;;
    esac
}

# Resolve one @requires token, which may be an `a|b|c` alternatives group.
#
#   * a group is satisfied when an installed alternative is a real package on
#     this platform (so `pip|pip3` with pip3 present installs nothing)
#   * otherwise the first alternative that maps to a real package wins (so
#     `gsed|sed` installs gnu-sed on macOS even though BSD sed is present)
#   * a group whose only members are base-OS tools is satisfied if any is present
resolve_requirement() {
    local token="$1" alt pkg oldifs="$IFS"
    local primary_tool="" primary_pkg="" satisfied_real=0 satisfied_any=0

    IFS='|'
    # shellcheck disable=SC2086
    set -- $token
    IFS="$oldifs"

    for alt in "$@"; do
        [ -n "$alt" ] || continue
        pkg="$(pkg_for "$alt")"
        if has "$alt"; then satisfied_any=1; fi
        if [ -n "$pkg" ] && [ "$pkg" != system ]; then
            if [ -z "$primary_tool" ]; then primary_tool="$alt"; primary_pkg="$pkg"; fi
            if has "$alt"; then satisfied_real=1; fi
        fi
    done

    if [ -z "$primary_pkg" ]; then
        [ "$satisfied_any" -eq 1 ] && return 0
        add_manual "$token"
        return 0
    fi
    if [ "$satisfied_real" -eq 1 ] || has "$primary_tool"; then
        return 0
    fi
    add_pkg "$primary_pkg"
}

for token in $REQUIRES; do
    resolve_requirement "$token"
done

# tooling this repo itself uses
for t in just shellcheck jq; do
    if ! has "$t"; then
        p="$(pkg_for "$t")"
        if [ -n "$p" ] && [ "$p" != system ]; then add_pkg "$p"; fi
    fi
done

if [ "$NO_INSTALL" -eq 1 ]; then
    if [ -n "$TO_INSTALL" ]; then
        note "would install:$TO_INSTALL"
    fi
    warn "--no-install (or no package manager): skipping package installation"
elif [ -z "$TO_INSTALL" ]; then
    ok "every declared dependency is already installed"
else
    n=$(printf '%s' "$TO_INSTALL" | wc -w | tr -d ' ')
    note "$n package(s) to install:$TO_INSTALL"
    if ask "Install them with $PKGMGR?"; then
        case "$PKGMGR" in
            brew)
                # shellcheck disable=SC2086
                run brew install $TO_INSTALL
                ;;
            apt)
                note "apt needs sudo to install system packages"
                run sudo apt-get update
                # shellcheck disable=SC2086
                run sudo apt-get install -y $TO_INSTALL
                ;;
            pacman)
                note "pacman needs sudo to install system packages"
                # shellcheck disable=SC2086
                run sudo pacman -S --needed --noconfirm $TO_INSTALL
                ;;
            dnf)
                note "dnf needs sudo to install system packages"
                # shellcheck disable=SC2086
                run sudo dnf install -y $TO_INSTALL
                ;;
        esac
    else
        warn "skipped package installation"
    fi
fi

if [ -n "$MANUAL" ]; then
    warn "no package known on this platform — install by hand if you want them:"
    for m in $MANUAL; do note "$m"; done
fi

# ================================================================= 3. symlink --

step "Linking ~/.shellrc"

LINK="$HOME/.shellrc"
TARGET="$REPO/shellrc"

link_ok=0
if [ -L "$LINK" ]; then
    current="$(command ls -ld -- "$LINK" | sed -e 's/.* -> //')"
    case "$current" in
        /*) resolved="$current" ;;
        *)  resolved="$HOME/$current" ;;
    esac
    if [ "$resolved" = "$TARGET" ]; then
        ok "~/.shellrc already points at $TARGET"
        link_ok=1
    else
        run mv -f "$LINK" "$LINK.bak-$STAMP"
        note "backed up the old symlink to ~/.shellrc.bak-$STAMP"
    fi
elif [ -e "$LINK" ]; then
    run mv -f "$LINK" "$LINK.bak-$STAMP"
    note "backed up your existing ~/.shellrc to ~/.shellrc.bak-$STAMP"
fi

if [ "$link_ok" -eq 0 ]; then
    run ln -s "$TARGET" "$LINK"
    ok "~/.shellrc -> $TARGET"
fi

# The old layout also symlinked ~/.shellrc.d. The loader self-locates now, so
# one symlink is enough — retire the second one rather than leaving it to rot.
if [ -L "$HOME/.shellrc.d" ]; then
    run mv -f "$HOME/.shellrc.d" "$HOME/.shellrc.d.bak-$STAMP"
    note "retired the legacy ~/.shellrc.d symlink (backed up)"
elif [ -d "$HOME/.shellrc.d" ]; then
    warn "~/.shellrc.d is a real directory — left alone. Nothing loads it any more."
fi

# ================================================================== 4. rc files --

step "Wiring up your rc files"

SOURCE_LINE='[ -r "$HOME/.shellrc" ] && . "$HOME/.shellrc"'
MARKER='# shellrc — managed by bin/bootstrap'

append_source_line() {
    local rc="$1" want_compinit="$2"

    if [ -f "$rc" ] && grep -q '\.shellrc' "$rc" 2>/dev/null; then
        ok "${rc/#$HOME/\~} already sources ~/.shellrc"
        return 0
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        printf '  %swould:%s append the source line to %s\n' \
            "$C_YELLOW" "$C_RESET" "${rc/#$HOME/\~}"
        return 0
    fi

    if [ -f "$rc" ]; then
        cp -p "$rc" "$rc.bak-$STAMP"
        note "backed up ${rc/#$HOME/\~}"
    fi

    {
        printf '\n%s\n' "$MARKER"
        if [ "$want_compinit" = yes ]; then
            printf 'autoload -Uz compinit && compinit\n'
        fi
        printf '%s\n' "$SOURCE_LINE"
    } >> "$rc"
    ok "appended the source line to ${rc/#$HOME/\~}"
}

append_source_line "$HOME/.zshrc"  yes
append_source_line "$HOME/.bashrc" no

# ================================================================ 5. local dir --

step "Machine-local config"

if [ -d "$REPO/modules/local" ]; then
    ok "modules/local/ exists (gitignored — put machine-specific config here)"
else
    run mkdir -p "$REPO/modules/local"
    if [ "$DRY_RUN" -eq 0 ]; then : > "$REPO/modules/local/.gitkeep"; fi
    ok "created modules/local/"
fi

# ==================================================================== 6. docs --

step "Documentation"

if [ "$DRY_RUN" -eq 1 ]; then
    printf '  %swould:%s regenerate docs/ with bin/shellrc-doc\n' "$C_YELLOW" "$C_RESET"
else
    run "$REPO/bin/shellrc-doc" --quiet
    ok "docs/INDEX.md, docs/functions.json and docs/reference/ are current"
fi

# ================================================================== 7. doctor --

step "Health check"

if [ -x "$REPO/bin/doctor" ]; then
    "$REPO/bin/doctor" || true
else
    warn "bin/doctor is missing"
fi

printf '\n%s%sDone.%s Open a new shell, or run: %ssource ~/.shellrc%s\n' \
    "$C_BOLD" "$C_B_GREEN" "$C_RESET" "$C_CYAN" "$C_RESET"
printf 'Then try %sshelp%s to search everything this config gives you.\n' \
    "$C_CYAN" "$C_RESET"
