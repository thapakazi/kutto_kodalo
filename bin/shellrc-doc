#!/usr/bin/env bash
# shellrc-doc — generate documentation from the doc blocks in lib/ and modules/.
#
# Reads the `# @tag` doc-block format defined in docs/CONVENTIONS.md and emits:
#
#   docs/reference/<module>.md   one page per module
#   docs/INDEX.md                every function, one line each
#   docs/functions.json          machine-readable, for agents and `shelp`
#
# Pure bash + awk/sed. No python, node, perl or any other runtime.
#
# Usage:
#   bin/shellrc-doc               regenerate everything
#   bin/shellrc-doc --check       exit 1 if regenerating would change anything
#   bin/shellrc-doc --quiet       no progress chatter (warnings still print)
#   bin/shellrc-doc --list-requires
#                                 print the union of @requires tokens, one per
#                                 line (bootstrap derives its package set here)
#   bin/shellrc-doc --include-private
#                                 also document _-prefixed helpers

set -euo pipefail

# ------------------------------------------------------------------ locate --

_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
    _link=$(command ls -ld -- "$_self" | sed -e 's/.* -> //')
    case "$_link" in
        /*) _self="$_link" ;;
        *)  _self="$(dirname -- "$_self")/$_link" ;;
    esac
done
REPO="$(cd -- "$(dirname -- "$_self")/.." && pwd -P)"
unset _self _link

DOCS="$REPO/docs"
REFDIR="$DOCS/reference"

BANNER_MD='<!-- DO NOT EDIT — generated by bin/shellrc-doc. Run `just docs` to regenerate. -->'

# ------------------------------------------------------------------- flags --

CHECK=0
QUIET=0
INCLUDE_PRIVATE=0
LIST_REQUIRES=0

while [ $# -gt 0 ]; do
    case "$1" in
        --check)           CHECK=1 ;;
        -q | --quiet)      QUIET=1 ;;
        --include-private) INCLUDE_PRIVATE=1 ;;
        --list-requires)   LIST_REQUIRES=1; QUIET=1 ;;
        -h | --help)
            sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            printf 'shellrc-doc: unknown option: %s\n' "$1" >&2
            exit 2
            ;;
    esac
    shift
done

say() { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*" >&2; }

# ------------------------------------------------------------------ inputs --

# lib/*.sh plus modules/<os>/*.sh. modules/local/ is machine-specific and
# gitignored, so it never appears in committed documentation.
collect_sources() {
    {
        if [ -d "$REPO/lib" ]; then
            find "$REPO/lib" -maxdepth 1 -type f -name '*.sh' 2>/dev/null || true
        fi
        if [ -d "$REPO/modules" ]; then
            find "$REPO/modules" -mindepth 2 -maxdepth 2 -type f -name '*.sh' \
                -not -path "$REPO/modules/local/*" 2>/dev/null || true
        fi
    } | LC_ALL=C sort
}

TMP="$(mktemp -d "${TMPDIR:-/tmp}/shellrc-doc.XXXXXXXX")"
trap 'rm -rf "$TMP"' EXIT INT TERM

SRC_LIST="$TMP/sources"
collect_sources > "$SRC_LIST"

# --------------------------------------------------------------- the parser --
#
# Emits one record per function. Fields are separated by US (\037); repeated
# values inside a field by RS (\036). Field order:
#
#   1 module  2 module-summary  3 file  4 line  5 name  6 describe  7 usage
#   8 examples  9 requires  10 os  11 danger  12 see  13 private  14 complete

read_parser() {
    cat <<'PARSER_AWK'
function reset_block(   i) {
    d_describe = ""; d_usage = ""; d_os = ""; d_danger = ""; d_see = ""
    d_req = ""; d_complete = ""; ex_n = 0; last_tag = ""; have_block = 0
}
function append_tag(tag, text) {
    if      (tag == "summary")  msummary   = joinl(msummary, text)
    else if (tag == "describe") d_describe = joinl(d_describe, text)
    else if (tag == "usage")    d_usage    = joinl(d_usage, text)
    else if (tag == "requires") d_req      = joinl(d_req, text)
    else if (tag == "danger")   d_danger   = joinl(d_danger, text)
    else if (tag == "see")      d_see      = joinl(d_see, text)
    else if (tag == "complete") d_complete = joinl(d_complete, text)
    else if (tag == "os")       d_os       = joinl(d_os, text)
    else if (tag == "example" && ex_n > 0) ex[ex_n] = joinl(ex[ex_n], text)
}
function joinl(a, b) { return (a == "") ? b : a " " b }
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }

function emit(name, lineno,   i, exs, private, rec) {
    private = (name ~ /^_/) ? 1 : 0
    if (private && !include_private) { reset_block(); return }

    # private helpers are meant to be undocumented; only flag public gaps
    if (!private && (!have_block || d_describe == "")) {
        printf("shellrc-doc: warning: %s:%d: function `%s` has no doc block\n",
               relfile, lineno, name) > "/dev/stderr"
    }

    exs = ""
    for (i = 1; i <= ex_n; i++) exs = (i == 1) ? ex[i] : exs RSEP ex[i]

    rec = (module == "" ? deffmod : module)
    rec = rec US msummary
    rec = rec US relfile
    rec = rec US lineno
    rec = rec US name
    rec = rec US d_describe
    rec = rec US d_usage
    rec = rec US exs
    rec = rec US d_req
    rec = rec US (d_os == "" ? "any" : d_os)
    rec = rec US d_danger
    rec = rec US d_see
    rec = rec US private
    rec = rec US d_complete
    print rec
    reset_block()
}

BEGIN {
    US = "\037"; RSEP = "\036"
}

FNR == 1 {
    relfile = FILENAME
    if (index(relfile, root "/") == 1) relfile = substr(relfile, length(root) + 2)
    deffmod = relfile
    sub(/^.*\//, "", deffmod)
    sub(/\.sh$/, "", deffmod)
    module = ""; msummary = ""
    reset_block()
}

{
    line = $0

    # ---- comment line: accumulate doc block ----
    # Opt out of the "indented, not documented" warning for deliberate cases
    # such as lazy-loading stubs. Must be tested BEFORE the comment handler
    # below, which consumes every comment line it sees.
    if (line ~ /^[ \t]*#[ \t]*shellrc-doc:[ \t]*ignore/) { doc_ignore = 1; next }

    if (line ~ /^[ \t]*#/) {
        ctext = line
        sub(/^[ \t]*#/, "", ctext)

        if (ctext ~ /^[ \t]*$/) {           # a bare `#` separator line
            last_tag = ""
            next
        }
        # strip exactly one space after the '#' so continuation indentation
        # survives and is recognisable
        sub(/^ /, "", ctext)

        if (ctext ~ /^@[A-Za-z_]+/) {
            tag = ctext
            sub(/^@/, "", tag)
            sub(/[ \t].*$/, "", tag)
            val = ctext
            sub(/^@[A-Za-z_]+[ \t]*/, "", val)
            val = trim(val)

            if (tag == "module") {
                module = val
                last_tag = ""
            } else if (tag == "summary") {
                msummary = val
                last_tag = "summary"
            } else if (tag == "example") {
                ex_n++
                ex[ex_n] = val
                last_tag = "example"
                have_block = 1
            } else if (tag == "describe" || tag == "usage" || tag == "os" ||
                       tag == "requires" || tag == "danger" || tag == "see" ||
                       tag == "complete") {
                last_tag = tag
                have_block = 1
                if      (tag == "describe") d_describe = val
                else if (tag == "usage")    d_usage    = val
                else if (tag == "os")       d_os       = val
                else if (tag == "requires") d_req      = joinl(d_req, val)
                else if (tag == "danger")   d_danger   = val
                else if (tag == "see")      d_see      = val
                else if (tag == "complete") d_complete = val
            } else {
                last_tag = ""               # unknown @tag, ignore quietly
            }
            next
        }

        # continuation line: indented prose under the previous tag
        if (last_tag != "" && ctext ~ /^[ \t]+[^ \t]/) {
            append_tag(last_tag, trim(ctext))
            next
        }

        last_tag = ""                       # ordinary comment prose
        next
    }

    # ---- blank line breaks the association with any doc block ----
    if (line ~ /^[ \t]*$/) { reset_block(); next }

    # ---- function definition? ----
    #   name() {           and        function name {  /  function name() {
    if (match(line, /^[A-Za-z_][A-Za-z0-9_]*[ \t]*\(\)/)) {
        fname = substr(line, RSTART, RLENGTH)
        sub(/[ \t]*\(\)$/, "", fname)
        emit(fname, FNR)
        next
    }
    # ---- an INDENTED definition is invisible to the matchers above ----
    # The anchors are deliberate: only column-0 definitions are part of the
    # public API. But silently dropping an indented one is how a function
    # disappears from the docs, from shelp and from the site with no error at
    # all -- e.g. after a reformat, or after being wrapped in an
    # `if require ...; then` block. Warn loudly instead.
    if (match(line, /^[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*\(\)/) ||
        match(line, /^[ \t]+function[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
        iname = substr(line, RSTART, RLENGTH)
        sub(/^[ \t]+/, "", iname); sub(/^function[ \t]+/, "", iname)
        sub(/[ \t]*\(\)$/, "", iname)
        # Only warn when a doc block is actually pending. That is the real
        # failure -- someone documented a function and then indented it, so it
        # vanishes silently. Without this guard the check also fires on awk
        # functions inside embedded awk programs, and on nested shell helpers
        # that were never meant to be public.
        if (iname !~ /^_/ && !doc_ignore && have_block) {
            printf("shellrc-doc: warning: %s:%d: `%s` is indented, so it is NOT documented" \
                   " (definitions must start at column 0)\n", FILENAME, FNR, iname) > "/dev/stderr"
        }
        doc_ignore = 0
        reset_block()
        next
    }
    if (match(line, /^function[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
        fname = substr(line, RSTART, RLENGTH)
        sub(/^function[ \t]+/, "", fname)
        emit(fname, FNR)
        next
    }

    # anything else (assignments, `require docker || return 0`, …) drops the
    # pending block so stray comments never attach to the wrong function
    reset_block()
}
PARSER_AWK
}

RECORDS="$TMP/records"
: > "$RECORDS"

read_parser > "$TMP/parse.awk"

if [ -s "$SRC_LIST" ]; then
    # read the file list into an array so paths containing spaces survive
    sources=()
    while IFS= read -r _f; do
        [ -n "$_f" ] && sources+=("$_f")
    done < "$SRC_LIST"
    if [ "${#sources[@]}" -gt 0 ]; then
        LC_ALL=C awk -v root="$REPO" -v include_private="$INCLUDE_PRIVATE" \
            -f "$TMP/parse.awk" "${sources[@]}" > "$RECORDS"
    fi
fi

SORTED="$TMP/sorted"
LC_ALL=C sort -t "$(printf '\037')" -k1,1 -k5,5 "$RECORDS" > "$SORTED"

# --------------------------------------------------------- --list-requires --

if [ "$LIST_REQUIRES" -eq 1 ]; then
    # Only requirements that can apply to this machine: a darwin-only function's
    # tools are not worth installing on Linux and vice versa.
    case "$(uname -s)" in
        Darwin) this_os=darwin ;;
        Linux)  this_os=linux ;;
        *)      this_os=any ;;
    esac
    LC_ALL=C awk -F "$(printf '\037')" -v os="$this_os" '
        $10 != "any" && $10 != os && os != "any" { next }
        {
            n = split($9, a, /[ \t]+/)
            for (i = 1; i <= n; i++) if (a[i] != "") print a[i]
        }' "$SORTED" | LC_ALL=C sort -u
    exit 0
fi

# ------------------------------------------------------------- the emitter --

read_emitter() {
    cat <<'EMIT_AWK'
function jesc(s,   out, i, n, c, o) {
    out = ""; n = length(s)
    for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if      (c == "\\") out = out "\\\\"
        else if (c == "\"") out = out "\\\""
        else if (c == "\n") out = out "\\n"
        else if (c == "\r") out = out "\\r"
        else if (c == "\t") out = out "\\t"
        else if (c == "\b") out = out "\\b"
        else if (c == "\f") out = out "\\f"
        else {
            o = ORD[c]
            if (o != "" && o < 32) out = out sprintf("\\u%04x", o)
            else out = out c
        }
    }
    return out
}
function jstr(s) { return "\"" jesc(s) "\"" }

function jarr(s, sep,   n, a, i, out) {
    if (s == "") return "[]"
    n = split(s, a, sep)
    out = "["
    for (i = 1; i <= n; i++) {
        if (a[i] == "") continue
        out = out (out == "[" ? "" : ", ") jstr(a[i])
    }
    return out "]"
}

# first sentence of a describe block, for the one-line index
function firstsent(s,   n, i, c, nx, pv) {
    n = length(s)
    for (i = 2; i <= n; i++) {
        c = substr(s, i, 1)
        if (c != ".") continue
        nx = substr(s, i + 1, 1)
        if (nx != "" && nx != " ") continue
        pv = substr(s, i - 2, 2)
        if (pv ~ /^[ (][A-Za-z]$/) continue     # e.g. "e.g." / "i.e."
        return substr(s, 1, i)
    }
    return s
}

function osbadge(o) {
    if (o == "darwin") return "macOS only"
    if (o == "linux")  return "Linux only"
    return "any"
}

function anchor(s) { return tolower(s) }

BEGIN {
    US = "\037"; RSEP = "\036"
    FS = US
    for (i = 1; i < 256; i++) ORD[sprintf("%c", i)] = i

    json = outdir "/functions.json"
    index_md = outdir "/INDEX.md"

    printf("[\n") > json
    first = 1

    nmod = 0
    nfun = 0
}

{
    module = $1; msummary = $2; file = $3; line = $4; name = $5
    describe = $6; usage = $7; examples = $8; requires = $9
    os = $10; danger = $11; see = $12; private = $13; complete = $14

    nfun++

    # ---------------- functions.json ----------------
    if (!first) printf(",\n") > json
    first = 0
    printf("  {\n") > json
    printf("    \"name\": %s,\n", jstr(name)) > json
    printf("    \"module\": %s,\n", jstr(module)) > json
    printf("    \"module_summary\": %s,\n", jstr(msummary)) > json
    printf("    \"file\": %s,\n", jstr(file)) > json
    printf("    \"line\": %d,\n", line + 0) > json
    printf("    \"describe\": %s,\n", jstr(describe)) > json
    printf("    \"usage\": %s,\n", jstr(usage)) > json
    printf("    \"examples\": %s,\n", jarr(examples, RSEP)) > json
    printf("    \"requires\": %s,\n", jarr(requires, "[ \t]+")) > json
    printf("    \"os\": %s,\n", jstr(os)) > json
    printf("    \"danger\": %s,\n", jstr(danger)) > json
    printf("    \"see\": %s,\n", jarr(see, "[ \t,]+")) > json
    printf("    \"private\": %s,\n", private + 0 ? "true" : "false") > json
    printf("    \"complete\": %s\n", jstr(complete)) > json
    printf("  }") > json

    # ---------------- per-module page ----------------
    if (!(module in seen_mod)) {
        seen_mod[module] = 1
        nmod++
        modorder[nmod] = module
        modcount[module] = 0
        modsum[module] = msummary
        modfiles[module] = file
        page = outdir "/reference/" module ".md"
        modpage[module] = page
        printf("%s\n\n", banner) > page
        printf("# %s\n\n", module) > page
        if (msummary != "") printf("%s\n\n", msummary) > page
    } else if (index(modfiles[module], file) == 0) {
        modfiles[module] = modfiles[module] " " file
    }
    modcount[module]++
    page = modpage[module]

    printf("---\n\n") > page
    printf("## `%s`\n\n", name) > page
    if (describe != "") printf("%s\n\n", describe) > page
    else                printf("_Undocumented — this function has no doc block._\n\n") > page

    if (danger != "") {
        printf("> **⚠ DANGER** — %s\n\n", danger) > page
    }

    if (usage != "") {
        printf("**Usage**\n\n```sh\n%s\n```\n\n", usage) > page
    }

    if (examples != "") {
        n = split(examples, exa, RSEP)
        printf("**Examples**\n\n```sh\n") > page
        for (i = 1; i <= n; i++) if (exa[i] != "") printf("%s\n", exa[i]) > page
        printf("```\n\n") > page
    }

    reqtxt = ""
    if (requires != "") {
        n = split(requires, rqa, "[ \t]+")
        for (i = 1; i <= n; i++) {
            if (rqa[i] == "") continue
            item = rqa[i]
            if (index(item, "|") > 0) {
                gsub(/\|/, "` or `", item)
                item = "(`" item "`)"
            } else {
                item = "`" item "`"
            }
            reqtxt = reqtxt (reqtxt == "" ? "" : ", ") item
        }
    }
    if (reqtxt != "") printf("**Requires** %s\n\n", reqtxt) > page

    printf("**OS** %s &nbsp;·&nbsp; **Source** [`%s:%s`](../../%s#L%s)\n\n",
           osbadge(os), file, line, file, line) > page

    if (see != "") {
        n = split(see, sea, "[ \t,]+")
        stxt = ""
        for (i = 1; i <= n; i++) if (sea[i] != "") stxt = stxt (stxt == "" ? "" : ", ") "`" sea[i] "`"
        if (stxt != "") printf("**See also** %s\n\n", stxt) > page
    }

    # ---------------- index rows ----------------
    idx_n[module]++
    row = "- [`" name "`](reference/" module ".md#" anchor(name) ") — " \
          (describe == "" ? "_undocumented_" : firstsent(describe))
    idx[module, idx_n[module]] = row
}

END {
    printf("\n]\n") > json
    close(json)

    printf("%s\n\n", banner) > index_md
    printf("# Function index\n\n") > index_md
    printf("This file is generated by `bin/shellrc-doc` from the doc blocks in\n") > index_md
    printf("`lib/` and `modules/`. **Do not edit it by hand** — edit the doc block\n") > index_md
    printf("above the function and run `just docs`.\n\n") > index_md
    printf("**%d function%s across %d module%s.**\n\n",
           nfun, (nfun == 1 ? "" : "s"), nmod, (nmod == 1 ? "" : "s")) > index_md
    printf("Machine-readable form: [`functions.json`](functions.json). ") > index_md
    printf("Authoring rules: [`CONVENTIONS.md`](CONVENTIONS.md).\n\n") > index_md

    if (nfun == 0) {
        printf("_No documented functions found._\n") > index_md
    }

    for (m = 1; m <= nmod; m++) {
        mod = modorder[m]
        printf("## [%s](reference/%s.md)\n\n", mod, mod) > index_md
        if (modsum[mod] != "") printf("%s\n\n", modsum[mod]) > index_md
        for (i = 1; i <= idx_n[mod]; i++) printf("%s\n", idx[mod, i]) > index_md
        printf("\n") > index_md

        # footer on the module page
        page = modpage[mod]
        printf("---\n\n") > page
        printf("_%d function%s. Source: ", modcount[mod], (modcount[mod] == 1 ? "" : "s")) > page
        n = split(modfiles[mod], fa, " ")
        for (i = 1; i <= n; i++) printf("%s`%s`", (i == 1 ? "" : ", "), fa[i]) > page
        printf(". Generated by `bin/shellrc-doc`._\n") > page
        close(page)
    }
    close(index_md)

    # module list for the caller (stdout)
    for (m = 1; m <= nmod; m++) printf("%s\n", modorder[m])
}
EMIT_AWK
}

OUT="$TMP/out"
mkdir -p "$OUT/reference"

MODULES_FOUND="$TMP/modules"
read_emitter > "$TMP/emit.awk"
LC_ALL=C awk -v outdir="$OUT" -v banner="$BANNER_MD" -f "$TMP/emit.awk" \
    "$SORTED" > "$MODULES_FOUND"

# ------------------------------------------------------------ check / write --

changed=0
note_change() {
    changed=1
    # always visible under --check, even with --quiet: this IS the output
    if [ "$CHECK" -eq 1 ]; then
        printf 'shellrc-doc: would change: %s\n' "$1" >&2
    fi
    return 0
}

compare_file() {
    local new="$1" old="$2"
    if [ ! -f "$old" ] || ! cmp -s "$new" "$old"; then
        note_change "${old#"$REPO"/}"
    fi
}

compare_file "$OUT/INDEX.md" "$DOCS/INDEX.md"
compare_file "$OUT/functions.json" "$DOCS/functions.json"

# new / modified module pages
for f in "$OUT/reference"/*.md; do
    [ -f "$f" ] || continue
    compare_file "$f" "$REFDIR/$(basename "$f")"
done

# stale module pages that no longer have a source module
if [ -d "$REFDIR" ]; then
    for f in "$REFDIR"/*.md; do
        [ -f "$f" ] || continue
        if [ ! -f "$OUT/reference/$(basename "$f")" ]; then
            note_change "docs/reference/$(basename "$f") (stale)"
        fi
    done
fi

if [ "$CHECK" -eq 1 ]; then
    if [ "$changed" -eq 1 ]; then
        printf 'shellrc-doc: documentation is out of date — run `just docs`\n' >&2
        exit 1
    fi
    say "shellrc-doc: documentation is up to date"
    exit 0
fi

mkdir -p "$REFDIR"
cp "$OUT/INDEX.md" "$DOCS/INDEX.md"
cp "$OUT/functions.json" "$DOCS/functions.json"

for f in "$OUT/reference"/*.md; do
    [ -f "$f" ] || continue
    cp "$f" "$REFDIR/$(basename "$f")"
done
for f in "$REFDIR"/*.md; do
    [ -f "$f" ] || continue
    if [ ! -f "$OUT/reference/$(basename "$f")" ]; then
        rm -f "$f"
        say "removed stale $(basename "$f")"
    fi
done

nfun=$(wc -l < "$SORTED" | tr -d ' ')
nmod=$(wc -l < "$MODULES_FOUND" | tr -d ' ')
say "shellrc-doc: $nfun functions across $nmod modules -> docs/INDEX.md, docs/functions.json, docs/reference/"
