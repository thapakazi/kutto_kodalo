#compdef shelp
# zsh completion for `shelp`, driven entirely by docs/functions.json.
# Regenerate that file with `just docs` — the candidate lists need no
# maintenance of their own; only the flag list below is hand-written.
#
# Hand-written rather than generated because shelp's interface is flags, and
# @complete only describes positional arguments. bin/shellrc-completions reads
# the #compdef line above and leaves these names alone.

local _shelp_db="${SHELLRC_ROOT:-}/docs/functions.json"

# name:description pairs, colons escaped so _describe does not split on them
_shelp_pairs() {
    [[ -r $_shelp_db ]] || return 1
    LC_ALL=C awk '
        /^  [{]/ { name = ""; desc = ""; priv = "false"; next }
        /^    "name": / {
            name = $0
            sub(/^    "name": "/, "", name); sub(/",$/, "", name)
            next
        }
        /^    "describe": / {
            desc = $0
            sub(/^    "describe": "/, "", desc); sub(/",$/, "", desc)
            next
        }
        /^    "private": / { priv = ($0 ~ /true/) ? "true" : "false"; next }
        /^  [}]/ {
            if (priv == "true" || name == "") next
            # first sentence only, keeps the completion list readable
            if (match(desc, /\. /)) desc = substr(desc, 1, RSTART)
            gsub(/\\"/, "\"", desc)
            gsub(/\\\\/, "\\", desc)
            gsub(/:/, "\\:", desc)
            gsub(/:/, "\\:", name)
            printf("%s:%s\n", name, desc)
        }
    ' "$_shelp_db"
}

_shelp_module_list() {
    [[ -r $_shelp_db ]] || return 1
    LC_ALL=C awk '
        /^    "module": "/ {
            m = $0; sub(/^    "module": "/, "", m); sub(/",$/, "", m)
            if (!(m in seen)) { seen[m] = 1; print m }
        }
    ' "$_shelp_db"
}

local curcontext="$curcontext" state line ret=1
typeset -A opt_args

# The flags are mutually exclusive: each selects a different mode.
_arguments -C \
    '(- *)'{-h,--help}'[show usage]' \
    '(- *)'{-m,--module}'[list every function in one module]:module:->modules' \
    '(- *)'{-s,--show}'[show full documentation for one function]:function:->functions' \
    '(- *)'{-i,--interactive}'[fuzzy picker with live preview]:initial query:->functions' \
    '1:query:->functions' && ret=0

case "$state" in
    modules)
        local -a mods
        mods=(${(f)"$(_shelp_module_list)"})
        if (( ${#mods} )); then
            _describe -t modules 'module' mods && ret=0
        else
            _message 'module (run `just docs` to build the index)'
        fi
        ;;
    functions)
        local -a funcs
        funcs=(${(f)"$(_shelp_pairs)"})
        if (( ${#funcs} )); then
            _describe -t functions 'function' funcs && ret=0
        else
            _message 'search query (run `just docs` to build the index)'
        fi
        ;;
esac

return ret
